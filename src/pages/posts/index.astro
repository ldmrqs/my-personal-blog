---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<BaseLayout title="posts - rato's world" currentPage="posts">
    <section class="content-section" style="margin-bottom: 30px;">
        <h2>[ posts ]</h2>
        <div class="about-content">
            {sortedPosts.map((post) => (
                <p><a href={`/posts/${post.id}/`}>{post.data.title}</a></p>
            ))}
        </div>
    </section>

    <!-- Back to home button -->
    <div class="back-button-container">
        <button class="retro-button" onclick="window.location.href='/'">
            &larr; BACK TO HOME
        </button>
    </div>
</BaseLayout>
