---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="music - rato's world" currentPage="music">
    <!-- Games Header Section -->
    <section class="content-section" style="margin-bottom: 30px;">
        <h2>[ music ]</h2>
        <div class="games-intro">
            <img src="/assets/top.gif" alt="twenty one pilots gif" class="top gif">
            <p>favorite artists: twenty one pilots, linkin park, paramore, the smiths, fall out boy, supercombo.</p>
            <p>this is my space to talk about music i'm listening to.</p>
        </div>
    </section>

    <!-- covers -->
    <section class="content-section">
        <h2>[ favorite albuns ]</h2>
        <table class="games-table">
            <tr>
                <td class="game-title"><a href="https://music.apple.com/br/album/twenty-one-pilots/1784341970">twenty one pilots</a></td>
                <td class="game-platform">twenty one pilots</td>
            </tr>
            <tr>
                <td class="game-title"><a href="https://music.apple.com/br/album/brand-new-eyes-deluxe/610141873">brand new eyes</a></td>
                <td class="game-platform">paramore</td>
            </tr>
            <tr>
                <td class="game-title"><a href="https://music.apple.com/br/album/meat-is-murder/799986977">meat is murder</a></td>
                <td class="game-platform">the smiths</td>
            </tr>
            <tr>
                <td class="game-title"><a href="https://music.apple.com/br/album/folie-%C3%A0-deux-bonus-track-version/1440728963">folie a deux</a></td>
                <td class="game-platform">fall out boy</td>
            </tr>
            <tr>
                <td class="game-title"><a href="https://music.apple.com/br/album/rog%C3%A9rio/1680721294">rogério</a></td>
                <td class="game-platform">supercombo</td>
            </tr>
            <tr>
                <td class="game-title"><a href="https://music.apple.com/br/album/minutes-to-midnight-deluxe-edition/1622307157">minutes to midnight</a></td>
                <td class="game-platform">linkin park</td>
            </tr>
        </table>
    </section>

    <!-- Back to home button -->
    <div class="back-button-container">
        <button class="retro-button" onclick="window.location.href='/'">
            &larr; BACK TO HOME
        </button>
    </div>
</BaseLayout>
